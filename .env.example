# ============================================================
# 豆包每日签到 · 本地配置文件示例
# 复制本文件为 .env 后填写（.env 已被 .gitignore 排除，不会上传）
# ============================================================

# ---------- 必填 ----------
# 可粘贴完整 Cookie；也可以直接粘贴 DevTools 复制出的 Copy as cURL (cmd) 命令，脚本会自动提取 Cookie。
DOUBAO_COOKIE="粘贴 Cookie 或 cURL 命令"

# ---------- 豆包「天天领额度」签到接口（已按当前网页版实测参数预填）----------
DOUBAO_CHECKIN_URL="https://www.doubao.com/alice/ug/campaign/landing/checkin?version_code=20800&language=zh&device_platform=web&doubao_device_platform=web&aid=497858&real_aid=497858&pkg_type=release_version&pc_version=3.43.4&doubao_pc_version=3.43.4&region=CN&sys_region=CN&samantha_web=1&web_platform=desktop&use-olympus-account=1"
DOUBAO_CHECKIN_METHOD=POST
DOUBAO_CHECKIN_BODY={"scene":"pc_incentive_task_mvp_v3"}
DOUBAO_EXTRA_HEADERS={"Referer":"https://www.doubao.com/","agw-js-conv":"str"}

# ---------- 结果判定（当前接口实测响应：code=0、data.checked_in=true；幂等时 data.idempotent=true）----------
DOUBAO_SUCCESS_JSON_PATH=data.checked_in=true
DOUBAO_ALREADY_JSON_PATH=data.idempotent=true
# 命中任意一个关键词即认为成功
# DOUBAO_SUCCESS_KEYWORDS=签到成功,领取成功,success
# 命中即认为今天已经签过了（会被当作成功，不再重试）
# DOUBAO_ALREADY_KEYWORDS=已签到,重复签到,already

# ---------- 通知（可选，多个用英文逗号分隔）----------
# 支持：serverchan, wecom, telegram, bark, webhook
# DOUBAO_NOTIFY=serverchan,wecom
# DOUBAO_NOTIFY_ON_ALREADY=0

# SERVERCHAN_KEY=SCTxxxxxxxxxxxxxxxx
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
# BARK_URL=https://api.day.app/yourkey
# CUSTOM_WEBHOOK=https://example.com/hook

# ---------- 调试 ----------
# DOUBAO_DEBUG=1
